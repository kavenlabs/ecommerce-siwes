{
  "name": "ecommerce-siwes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "serve": "node scripts/serve.mjs",
    "deploy": "npm run build && npm run serve",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "generate-routes": "tsr generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "user:password": "tsx scripts/set-password.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "1.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  }
}
