# Copy to .env and adjust. Every value here has a working default.

# Where the SQLite file lives. Defaults to ./data
# DATA_DIR=/var/lib/ecommerce-siwes

# Only used by npm run db:seed to create the first admin.
# The first account registered on a fresh database becomes the admin regardless.
# ADMIN_EMAIL=admin@adetunji.shop
# ADMIN_PASSWORD=change-me-before-going-live
